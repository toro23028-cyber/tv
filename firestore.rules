rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.time.toMillis() < request.auth.token.auth_time * 1000 + 28800000
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false; // Criação exclusivamente no Console ou Admin SDK.
    }
    match /channels/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.numero is int
        && request.resource.data.numero > 0 && request.resource.data.numero <= 9999
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0;
      allow delete: if isAdmin();
    }
    match /channelNumbers/{number} { allow read, write: if isAdmin(); }
    match /programs/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.duracao is number
        && request.resource.data.duracao > 0 && request.resource.data.duracao <= 2592000
        && request.resource.data.horarioInicio is number
        && request.resource.data.horarioInicio >= 0 && request.resource.data.horarioInicio < 86400;
      allow delete: if isAdmin();
    }
    match /editorialAutomation/{id} { allow read, write: if isAdmin(); }
    match /newsDrafts/{id} { allow read, write: if isAdmin(); }
    match /newsPublished/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
